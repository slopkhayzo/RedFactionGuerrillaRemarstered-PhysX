-	PxArray<PxU32> mNodeBitmap;			//! Each slab 1 integer per-node, recording the presence of the node in any of the slabs
+	PartitionNodePages<PxU32> mNodeBitmap;			//! Each slab 1 integer per-node, recording the presence of the node in any of the slabs
 
-	PxArray<NodeEntries> mNodeEntries;
+	PartitionNodePages<NodeEntries> mNodeEntries;
 
 	PartitionSlab()	{}
 };
