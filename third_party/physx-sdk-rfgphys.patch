+// rfgphys: what a slab keeps for each node, in pages made when first written. Past the first few slabs only the bodies with
+// the most contacts are in a slab, and yet each took 132 bytes for every node of the scene: 30 MB a slab at 224,000 nodes,
+// with nearly 200 slabs. A new slab cost 130 ms, and whenever the node count doubled all of them were made again: a step of
+// 25 s at 112,000 bodies.
+template <typename T>
+class PartitionNodePages
+{
+	static const PxU32 sPageBits = 6, sPageSize = 1u << sPageBits, sPageMask = sPageSize - 1;
+	PxArray<T*> mPages;
+
+	PX_NOINLINE T* addPage(T*& page)
+	{
+		page = PX_ALLOCATE(T, sPageSize, "PartitionNodePages");
+		PxMemZero(page, sizeof(T) * sPageSize);
+		return page;
+	}
+
+	PX_NOCOPY(PartitionNodePages)
+public:
+	PartitionNodePages() {}
+	~PartitionNodePages()
+	{
+		for (PxU32 i = 0; i < mPages.size(); ++i)
+			PX_FREE(mPages[i]);
+	}
+	void resize(PxU32 nodeCount) { mPages.resize((nodeCount + sPageMask) >> sPageBits); }
+	// To write: makes its page, if it is the first in it.
+	PX_FORCE_INLINE T& operator[](PxU32 index)
+	{
+		T*& page = mPages[index >> sPageBits];
+		return (page ? page : addPage(page))[index & sPageMask];
+	}
+	// Its page is there: its bit in the bitmap is set.
+	PX_FORCE_INLINE const T& operator[](PxU32 index) const { return mPages[index >> sPageBits][index & sPageMask]; }
+	// Makes no page: 0 if there is none.
+	PX_FORCE_INLINE T read(PxU32 index) const
+	{
+		const T* page = mPages[index >> sPageBits];
+		return page ? page[index & sPageMask] : T(0);
+	}
+};
+
