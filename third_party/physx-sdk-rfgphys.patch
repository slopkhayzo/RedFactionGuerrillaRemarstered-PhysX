+
+void PxgBodySimManager::refreshMaxStaticRBContacts()
+{
+	if(!mMaxStaticRBContactsStale)
+		return;
+	mMaxStaticRBContactsStale = false;
+	PxU32 most = 0;
+	for(PxU32 i = 0, n = mStaticConstraints.size(); i < n; ++i)
+		most = PxMax(most, mStaticConstraints[i].mStaticContacts.size());
+	mMaxStaticRBContacts = most;
 }
 
